import { useState } from 'react';
import { Search, Plus, Minus, Trash2, Receipt, FileText } from 'lucide-react';

interface Props {
  saleData: any;
  onUpdate: (data: any) => void;
  onEmit: () => void;
}

interface CartItem {
  id: string;
  description: string;
  quantity: number;
  unitPrice: number;
}

export default function CatalogFlow({ saleData, onUpdate, onEmit }: Props) {
  const [step, setStep] = useState(1);
  const [cart, setCart] = useState<CartItem[]>(saleData.items || []);
  const [customerType, setCustomerType] = useState<'GENERIC' | 'SEARCH' | 'NEW'>('GENERIC');
  const [documentType, setDocumentType] = useState<'BOLETA' | 'FACTURA'>('BOLETA');

  const sampleProducts = [
    { id: '1', name: 'Gaseosa 500ml', price: 3.00, type: 'PRODUCT' },
    { id: '2', name: 'Pan francés', price: 0.50, type: 'PRODUCT' },
    { id: '3', name: 'Jugo natural', price: 4.00, type: 'PRODUCT' },
    { id: '4', name: 'Consultoría', price: 100.00, type: 'SERVICE' },
  ];

  const addToCart = (product: any) => {
    const existing = cart.find(item => item.id === product.id);
    if (existing) {
      setCart(cart.map(item => 
        item.id === product.id 
          ? { ...item, quantity: item.quantity + 1 }
          : item
      ));
    } else {
      setCart([...cart, {
        id: product.id,
        description: product.name,
        quantity: 1,
        unitPrice: product.price,
      }]);
    }
  };

  const updateQuantity = (id: string, delta: number) => {
    setCart(prevCart => prevCart.map(item => {
      if (item.id === id) {
        const newQty = Math.max(1, item.quantity + delta);
        return { ...item, quantity: newQty };
      }
      return item;
    }));
  };

  const removeFromCart = (id: string) => {
    setCart(prevCart => prevCart.filter(item => item.id !== id));
  };

  // Cálculos DIRECTOS en cada render (sin useMemo)
  const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
  
  const subtotal = cart.reduce((sum, item) => {
    return sum + ((item.unitPrice / 1.18) * item.quantity);
  }, 0);
  
  const igv = cart.reduce((sum, item) => {
    return sum + ((item.unitPrice - item.unitPrice / 1.18) * item.quantity);
  }, 0);
  
  const total = cart.reduce((sum, item) => {
    return sum + (item.unitPrice * item.quantity);
  }, 0);

  const handleContinue = () => {
    const items = cart.map(item => ({
      description: item.description,
      quantity: item.quantity,
      unitPrice: item.unitPrice,
      subtotal: (item.unitPrice / 1.18) * item.quantity,
      igv: (item.unitPrice - item.unitPrice / 1.18) * item.quantity,
      total: item.unitPrice * item.quantity,
    }));

    onUpdate({
      ...saleData,
      items,
      customer: { type: customerType, name: 'Cliente Varios' },
      subtotal,
      igv,
      total,
      documentType,
    });
    setStep(step + 1);
  };

  if (step === 1) {
    return (
      <div className="space-y-6">
        <div className="text-center mb-8">
          <h2 className="text-2xl font-bold text-slate-900 mb-2">Selecciona productos</h2>
          <p className="text-slate-500">Busca o selecciona productos de tu catálogo</p>
        </div>

        <div className="relative">
          <Search className="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400" size={20} />
          <input type="text" placeholder="Buscar producto..." className="input-field pl-12" />
        </div>

        <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
          {sampleProducts.map(product => (
            <button
              key={product.id}
              onClick={() => addToCart(product)}
              className="card p-4 hover:shadow-md transition-all cursor-pointer text-left"
            >
              <div className="aspect-square bg-slate-100 rounded-lg mb-2 flex items-center justify-center">
                <span className="text-3xl">{product.type === 'PRODUCT' ? '📦' : ''}</span>
              </div>
              <h3 className="font-semibold text-sm text-slate-900 truncate">{product.name}</h3>
              <p className="text-primary-600 font-bold">S/ {product.price.toFixed(2)}</p>
            </button>
          ))}
        </div>

        {cart.length > 0 && (
          <div className="card">
            <h3 className="font-bold text-lg mb-4">Carrito ({totalItems} {totalItems === 1 ? 'item' : 'items'})</h3>
            <div className="space-y-3">
              {cart.map(item => (
                <div key={item.id} className="flex items-center justify-between py-2 border-b border-slate-100 last:border-0">
                  <div className="flex-1">
                    <p className="font-medium text-slate-900">{item.description}</p>
                    <p className="text-sm text-slate-500">S/ {item.unitPrice.toFixed(2)} c/u</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <button 
                      onClick={() => updateQuantity(item.id, -1)} 
                      className="p-1 hover:bg-slate-100 rounded"
                      disabled={item.quantity <= 1}
                    >
                      <Minus size={16} />
                    </button>
                    <span className="w-8 text-center font-semibold">{item.quantity}</span>
                    <button 
                      onClick={() => updateQuantity(item.id, 1)} 
                      className="p-1 hover:bg-slate-100 rounded"
                    >
                      <Plus size={16} />
                    </button>
                    <button 
                      onClick={() => removeFromCart(item.id)} 
                      className="p-1 text-red-600 hover:bg-red-50 rounded ml-2"
                    >
                      <Trash2 size={16} />
                    </button>
                  </div>
                </div>
              ))}
            </div>
            
            <div className="mt-4 pt-4 border-t border-slate-200 space-y-2">
              <div className="flex justify-between text-sm text-slate-600">
                <span>Total parcial</span>
                <span>S/ {subtotal.toFixed(2)}</span>
              </div>
              <div className="flex justify-between text-sm text-slate-600">
                <span>IGV (18%)</span>
                <span>S/ {igv.toFixed(2)}</span>
              </div>
              <div className="flex justify-between text-xl font-bold text-slate-900 pt-2 border-t border-slate-200">
                <span>Total</span>
                <span>S/ {total.toFixed(2)}</span>
              </div>
            </div>
          </div>
        )}

        <button
          onClick={handleContinue}
          disabled={cart.length === 0}
          className="btn-primary w-full py-4 text-lg disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Continuar
        </button>
      </div>
    );
  }

  if (step === 2) {
    return (
      <div className="space-y-6">
        <div className="text-center mb-8">
          <h2 className="text-2xl font-bold text-slate-900 mb-2">¿Quién compra?</h2>
          <p className="text-slate-500">Selecciona el tipo de cliente</p>
        </div>

        <div className="space-y-4">
          <button
            onClick={() => setCustomerType('GENERIC')}
            className={`card w-full p-6 flex items-center gap-4 transition-all cursor-pointer ${
              customerType === 'GENERIC' ? 'ring-4 ring-primary-500 bg-primary-50' : 'hover:shadow-md'
            }`}
          >
            <div className={`p-3 rounded-full ${customerType === 'GENERIC' ? 'bg-primary-600 text-white' : 'bg-slate-100 text-slate-600'}`}>
              <svg className="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
            </div>
            <div className="text-left">
              <h3 className="font-bold text-lg text-slate-900">Cliente genérico</h3>
              <p className="text-sm text-slate-500">Sin documento</p>
            </div>
          </button>

          <button
            onClick={() => setCustomerType('SEARCH')}
            className={`card w-full p-6 flex items-center gap-4 transition-all cursor-pointer ${
              customerType === 'SEARCH' ? 'ring-4 ring-primary-500 bg-primary-50' : 'hover:shadow-md'
            }`}
          >
            <div className={`p-3 rounded-full ${customerType === 'SEARCH' ? 'bg-primary-600 text-white' : 'bg-slate-100 text-slate-600'}`}>
              <Search size={24} />
            </div>
            <div className="text-left">
              <h3 className="font-bold text-lg text-slate-900">Buscar por DNI/RUC</h3>
              <p className="text-sm text-slate-500">Buscar cliente existente</p>
            </div>
          </button>
        </div>

        <button onClick={handleContinue} className="btn-primary w-full py-4 text-lg">
          Continuar
        </button>
      </div>
    );
  }

  return (
    <div className="space-y-6">
      <div className="text-center mb-8">
        <h2 className="text-2xl font-bold text-slate-900 mb-2">Resumen de venta</h2>
        <p className="text-slate-500">Revisa los datos antes de emitir</p>
      </div>

      <div className="card">
        <div className="space-y-3">
          {cart.map(item => (
            <div key={item.id} className="flex justify-between py-2 border-b border-slate-100 last:border-0">
              <div>
                <p className="font-medium text-slate-900">{item.description}</p>
                <p className="text-sm text-slate-500">{item.quantity} x S/ {item.unitPrice.toFixed(2)}</p>
              </div>
              <p className="font-semibold">S/ {(item.quantity * item.unitPrice).toFixed(2)}</p>
            </div>
          ))}
        </div>

        <div className="mt-4 pt-4 border-t border-slate-200 space-y-2">
          <div className="flex justify-between text-slate-600">
            <span>Subtotal</span>
            <span>S/ {subtotal.toFixed(2)}</span>
          </div>
          <div className="flex justify-between text-slate-600">
            <span>IGV (18%)</span>
            <span>S/ {igv.toFixed(2)}</span>
          </div>
          <div className="flex justify-between text-2xl font-bold text-slate-900 pt-2 border-t border-slate-200">
            <span>TOTAL</span>
            <span>S/ {total.toFixed(2)}</span>
          </div>
        </div>
      </div>

      <div className="card">
        <p className="text-sm font-medium text-slate-700 mb-3">Tipo de comprobante</p>
        <div className="grid grid-cols-2 gap-3">
          <button
            onClick={() => setDocumentType('BOLETA')}
            className={`py-3 px-4 border-2 rounded-lg font-semibold flex items-center justify-center gap-2 ${
              documentType === 'BOLETA'
                ? 'border-primary-600 bg-primary-50 text-primary-700'
                : 'border-slate-200 text-slate-600 hover:border-slate-300'
            }`}
          >
            <Receipt size={20} />
            Boleta
          </button>
          <button
            onClick={() => setDocumentType('FACTURA')}
            className={`py-3 px-4 border-2 rounded-lg font-semibold flex items-center justify-center gap-2 ${
              documentType === 'FACTURA'
                ? 'border-primary-600 bg-primary-50 text-primary-700'
                : 'border-slate-200 text-slate-600 hover:border-slate-300'
            }`}
          >
            <FileText size={20} />
            Factura
          </button>
        </div>
      </div>

      <div className="space-y-3">
        <button onClick={onEmit} className="btn-primary w-full py-4 text-lg">
          EMITIR COMPROBANTE
        </button>
        <button onClick={() => setStep(step - 1)} className="w-full py-3 text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">
          Volver
        </button>
      </div>
    </div>
  );
}
